  <data key="d0">Femme de 37 Ans</data>
  <data key="d1">person</data>
  <data key="d2">Femme de 37 Ans is one of the survey respondents who provides insights into her positive experiences and perceptions regarding life in Grosseto-Prugna.</data>
  <data key="d3">doc-fc76b7f4d4c75d4ea66d01fc9075ce68-chunk-000</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1787573569</data>
  <data key="d6"></data>
</node>
<node id="Homme de 51 Ans">
  <data key="d0">Homme de 51 Ans</data>
  <data key="d1">person</data>
  <data key="d2">Homme de 51 Ans is another survey respondent who shares his perspectives on quality of life in Grosseto-Prugna, reflecting concerns and satisfaction related to various themes.</data>
  <data key="d3">doc-fc76b7f4d4c75d4ea66d01fc9075ce68-chunk-000</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1787573569</data>
